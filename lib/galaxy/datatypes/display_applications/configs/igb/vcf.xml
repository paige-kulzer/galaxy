<display id="igb_vcf" version="1.0.0" name="display in IGB">
    <link id="View" name="View">
        <url>$bioviz</url>
        <param type="data" name="vcf_file_for_name" viewable="False"/>
        <param type="template" name="niceName" viewable="False" strip="True">
            #import re
            #set nm=$vcf_file_for_name.name
            ${re.sub('\W',"_",nm)}
        </param>
        <param type="data" name="vcf_file" url="${niceName}.vcf" />
        <param type="template" name="bioviz" strip="True" >
             http://bioviz.org/galaxy.html?version=${vcf_file.dbkey}&amp;loadresidues=false&amp;feature_url_0=${vcf_file.url}&amp;sym_name_0=${niceName}&amp;sym_method_0=${vcf_file.url}&amp;query_url=${vcf_file.url}&amp;server_url=galaxy
        </param>
    </link>
</display>
